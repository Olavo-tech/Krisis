{
  "name": "Eduquack",
  "short_name": "Eduquack",
  "description": "Seu espaço de estudo para vestibulares e editais, com o Tuck.",
  "lang": "pt-BR",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "portrait",
  "background_color": "#f2b705",
  "theme_color": "#f7f5ff",
  "icons": [
    { "src": "/api/icon?s=192", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/api/icon?s=512", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/api/icon?s=512&m=1", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": { "action": "/", "method": "GET", "params": { "title": "title", "text": "text", "url": "url" } },
  "shortcuts": [
    { "name": "Conversar com o Tuck", "url": "/#/tuck" },
    { "name": "Minha trilha", "url": "/#/trilha" },
    { "name": "Revisar cartões", "url": "/#/cartoes" }
  ]
}
